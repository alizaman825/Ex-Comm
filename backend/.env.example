# MongoDB Atlas connection string (your own cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/excomm?retryWrites=true&w=majority
# Database name when the URI has none (Atlas strings usually do not)
# DB_NAME=excomm
# Offline fallback: MONGO_URI=memory (embedded MongoDB kept in backend/.data)
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production (set false to test a production build on http://localhost)
# COOKIE_SECURE=false
# Proxy hops in front of the API (2 when deployed on Render behind the Vercel frontend)
# TRUST_PROXY=1
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Load sample data when the database is empty (true/false)
AUTO_SEED=true
# Demo mode: never scrape live, serve cache + sample data only
DEMO_MODE=false
# Live scraping (adapters: daraz, priceoye)
LIVE_PLATFORMS=daraz,priceoye
# eBay Browse API (on-demand "Check on eBay", like AliExpress): free keys at developer.ebay.com -> My Account
# -> Application Keys (production). Leave blank to disable the button; nothing else is affected.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
# Bright Data (optional, both on-demand): free trial at brightdata.com. BRIGHTDATA_API_KEY alone enables
# "Check on Amazon" (Bright Data's Amazon Scraper API). Also setting BRIGHTDATA_ZONE (a Web Unlocker zone:
# Proxies & Scraping -> Add zone -> Web Unlocker) routes "Check on AliExpress" through Bright Data's
# anti-bot network instead of a direct request, so it keeps working once AliExpress blocks this IP.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=3000
# Scheduled price check (cron) and manual trigger key (x-job-key header; leave empty to disable the endpoint)
JOBS_ENABLED=true
PRICE_CHECK_CRON=0 */6 * * *
JOB_KEY=
# Optional email alerts (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ex-Comm <alerts@example.com>
# Optional rate limits (requests per 15 min per IP)
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Background catalog sync (keeps the sample catalog's Daraz/PriceOye listings real, a few items per run)
CATALOG_SYNC_CRON=*/30 * * * *
CATALOG_SYNC_BATCH=8
CATALOG_SYNC_PLATFORMS=daraz,priceoye
