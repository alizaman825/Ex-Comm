# MongoDB Atlas connection string (your own cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/excomm?retryWrites=true&w=majority
# Database name when the URI has none (Atlas strings usually do not)
# DB_NAME=excomm
# Offline fallback: MONGO_URI=memory (embedded MongoDB kept in backend/.data)
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production (set false to test a production build on http://localhost)
# COOKIE_SECURE=false
# Proxy hops in front of the API (2 when deployed on Render behind the Vercel frontend)
# TRUST_PROXY=1
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Load sample data when the database is empty (true/false)
AUTO_SEED=true
# Demo mode: never scrape live, serve cache + sample data only
DEMO_MODE=false
# Live scraping (adapters: daraz, priceoye)
LIVE_PLATFORMS=daraz,priceoye
# eBay Browse API (on-demand "Check on eBay", like AliExpress): free keys at developer.ebay.com -> My Account
# -> Application Keys (production). Leave blank to disable the button; nothing else is affected.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=3000
# Scheduled price check (cron) and manual trigger key (x-job-key header; leave empty to disable the endpoint)
JOBS_ENABLED=true
PRICE_CHECK_CRON=0 */6 * * *
JOB_KEY=
# Optional email alerts (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ex-Comm <alerts@example.com>
# Optional rate limits (requests per 15 min per IP; AUTH_RATE_LIMIT_MAX is additionally keyed by
# the submitted email, so this is per IP+account, not a shared bucket for every user on an IP)
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# "Report a wrong price or product" (no login needed), per IP per 15 min
REPORT_RATE_LIMIT_MAX=5
# Contact form (Part D): no login needed, per IP, its own (hourly) window
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
# Contact form recipient (set in Render, never committed) and the pepper used to hash a submitter's
# IP before storing it (any random string; changing it later just makes old hashes uncomparable).
CONTACT_RECIPIENT_EMAIL=
CONTACT_IP_HASH_SALT=change-me-to-a-random-string
# Contact-message email notification (HTTP API, not SMTP - see backend/src/services/email.js): a free
# Resend API key at resend.com. Leave blank to disable the notification; the message is still saved and
# the form still succeeds either way.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Background catalog sync (keeps the sample catalog's Daraz/PriceOye listings real, a few items per run)
CATALOG_SYNC_CRON=*/30 * * * *
CATALOG_SYNC_BATCH=8
CATALOG_SYNC_PLATFORMS=daraz,priceoye
# How recently (hours) a product needs a checked, in-stock offer to lead the home page's trending/drops
# rails; older than this is left off rather than risk showing stale price/stock. See docs/DEPLOY.md #4
# for why the sync can fall behind on Render's free plan, and the GitHub Action that keeps it running.
HOME_FRESHNESS_HOURS=48
# "Biggest price drops" quality rules (C1): a cheap accessory or a category we haven't launched
# shouldn't lead the deals rail. Comma-separated; blank DEALS_CATEGORIES disables the category check.
DEALS_MIN_PRICE=2000
DEALS_EXCLUDED_KEYWORDS=case,cover,screen protector,tempered glass,cable,charger,adapter,strap,pouch,sleeve,skin
DEALS_CATEGORIES=mobiles,laptops,audio,watches,gpus,home-appliances
# Telex.pk (Telemart) background sync (Phase 2A): off by default. Discovers products via /sitemap.xml
# and reads each product page read-only (telex.pk/agents.md), a few at a time, with a polite delay and
# exponential backoff. Set to true only once you want it actually syncing (manual trigger or schedule).
SYNC_TELEX_ENABLED=false
TELEX_SYNC_CRON=0 */6 * * *
TELEX_MAX_PAGES_PER_RUN=10
TELEX_MIN_DELAY_MS=3000
TELEX_MAX_DELAY_MS=5000
